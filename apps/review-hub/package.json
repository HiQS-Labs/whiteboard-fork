{
  "name": "@dev.fast/review-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node ../../packages/review/node_modules/tsdown/dist/run.mjs src/server.ts",
    "start": "node dist/server.mjs",
    "dev": "tsx src/server.ts",
    "test": "vitest run",
    "test:ui": "node ../../scripts/ui-smoke-test.mjs",
    "typecheck": "pnpm -w exec tsc --noEmit -p apps/review-hub"
  },
  "dependencies": {
    "@dev.fast/review": "workspace:*",
    "@dev.fast/review-protocol": "workspace:*",
    "@dev.fast/review-share-protocol": "workspace:*",
    "@hono/node-server": "2.0.12",
    "hono": "4.13.7",
    "pino": "10.3.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "24.12.2",
    "pino-pretty": "13.1.3",
    "tsdown": "0.22.14",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
